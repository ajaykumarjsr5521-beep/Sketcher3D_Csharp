<Window x:Class="Sketcher3D_Csharp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sketcher3D"
        Width="1200"
        Height="720"
        WindowStartupLocation="CenterScreen">

    <DockPanel>

        <!-- MENU -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="File">
                <MenuItem Header="New" />
                <MenuItem Header="Open" />
                <MenuItem Header="Save" />
                <Separator/>
                <MenuItem Header="Exit" />
            </MenuItem>
        </Menu>

        <!-- TOOLBAR -->
        <ToolBar DockPanel.Dock="Top">
            <Button Content="Cube"/>
            <Button Content="Cuboid"/>
            <Button Content="Cylinder"/>
            <Button Content="Cone"/>
            <Button Content="Sphere"/>
            <Button Content="Pyramid"/>
        </ToolBar>

        <!-- VIEWPORT -->
        <Viewport3D>
            <Viewport3D.Camera>
                <PerspectiveCamera Position="0,0,200"
                                   LookDirection="0,0,-1"
                                   UpDirection="0,1,0"
                                   FieldOfView="45"/>
            </Viewport3D.Camera>

            <ModelVisual3D>
                <ModelVisual3D.Content>
                    <Model3DGroup>
                        <AmbientLight Color="#404040"/>
                        <DirectionalLight Color="White" Direction="-1,-2,-3"/>
                    </Model3DGroup>
                </ModelVisual3D.Content>
            </ModelVisual3D>
        </Viewport3D>

    </DockPanel>
</Window>

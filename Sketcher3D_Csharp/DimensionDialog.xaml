<Window x:Class="Sketcher3D_Csharp.DimensionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Enter Dimensions"
        Width="320"
        Height="260"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <StackPanel x:Name="Row1">
                <TextBlock x:Name="Label1"/>
                <TextBox x:Name="Box1"/>
            </StackPanel>

            <StackPanel x:Name="Row2" Margin="0,10,0,0">
                <TextBlock x:Name="Label2"/>
                <TextBox x:Name="Box2"/>
            </StackPanel>

            <StackPanel x:Name="Row3" Margin="0,10,0,0">
                <TextBlock x:Name="Label3"/>
                <TextBox x:Name="Box3"/>
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,15,0,0">
            <Button Content="OK" Width="70" Height="30"  Margin="5" Padding="5,2" Click="Ok_Click"/>
            <Button Content="Cancel" Width="70" Height="30" Margin="5" Padding="5,2" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
